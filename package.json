{
  "name": "fitpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "db:migrate:local": "wrangler d1 migrations apply fitpilot_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fitpilot_db --remote"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@auth/core": "0.35.3",
    "next-auth": "5.0.0-beta.25",
    "bcryptjs": "2.4.3",
    "zod": "3.23.8",
    "nanoid": "5.0.7"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.15",
    "@cloudflare/workers-types": "4.20240925.0",
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/bcryptjs": "2.4.6",
    "typescript": "5.5.3",
    "tailwindcss": "3.4.10",
    "postcss": "8.4.41",
    "autoprefixer": "10.4.20",
    "wrangler": "3.78.10"
  }
}
